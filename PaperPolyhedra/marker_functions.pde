//--RH-- Fiducial Marker Functions
/*
 * HARDCODED ARUCO MARKERS FOR PDF EXPORT
 *
 * ==============
 * It seems that calling loadImage() AFTER beginRecord(PDF) corrupts the PDF graphics state,
 * resulting in all-black pages when printing. By hardcoding marker data instead of loading
 * from an image file, we avoid this corruption entirely. Images are loaded BEFORE PDF recording
 * begins (in setParams() called from drawFrontPDF()), not during rendering.
 * 
 * DATA SOURCE
 * ===========
 * All 1024 marker payloads were extracted
 * extracted  8x8 pixel blocks → binarized → 5x5 center extracted
 * 
 */

void drawMarker(int marker_id, int marker_size, int marker_pos) {
  // DRAWS A SINGLE ARUCO MARKER
  // marker_id: Which marker to draw (0-1023)
  // marker_size: Size in units (roughly matching panel dimensions)
  // marker_pos: Position variant (currently unused, reserved for future enhancements)
  
  // Safety check - ensure marker data is initialized
  if (m == null || marker_id < 0 || marker_id >= m.length || m[marker_id] == null || m[marker_id].payload == null) {
    println("ERROR: Cannot draw marker " + marker_id + " - marker array not initialized or invalid reference");
    return;
  }
  
  // Calculate dimensions
  // ArUco marker is 8x8 in logical units, but we add padding (9/7 ratio)
  float mkr_actualsize = (float)marker_size*(9./7.);  // Add ~28% for border/white space
  float gridSize = mkr_actualsize/9.;  // Each logical cell size in pixels

  pushStyle();
  
  // Draw white background (ensures marker is visible on any background)
  // No outline — the ArUco pattern already has its own black border ring.
  fill(255);
  noStroke();
  rect(0, 0, mkr_actualsize, mkr_actualsize);
  
  // DRAW THE 8x8 MARKER GRID
  // Grid structure: 1px black border + 6px center + 1px black border
  // The 5x5 payload sits in the center 6x6 area (indices 1-6)
  for (int pi = 0; pi < 8; pi++) {
    for (int pj = 0; pj < 8; pj++) {
      boolean isBlack = false;
      
      // Outer black border (keeps outer ring at 0 and 7)
      if (pi > 0 && pi < 8 && pj > 0 && pj < 8) {
        // Inner payload area (indices 2-6, covers the 5x5 data)
        if (pi > 1 && pi < 7 && pj > 1 && pj < 7) {
          // CENTER PAYLOAD (5x5 hardcoded data)
          // Use the hardcoded 5x5 array: if value > 0, pixel is WHITE (=0 in isBlack)
          if (m[marker_id].payload[pi - 2][pj - 2] > 0) {
            isBlack = false; // White
          } else {
            isBlack = true; // Black
          }
        } else {
          // INNER BORDER (indices 1,6 on each axis = black frame)
          isBlack = true;
        }
      }
      
      // Draw the cell
      if (isBlack) {
        fill(0); // Black
      } else {
        fill(255); // White
      }
      noStroke();
      rect(round(pj * gridSize), round(pi * gridSize), ceil(gridSize), ceil(gridSize));
    }
  }
  
  // Draw marker ID label
  if (marker_id >= 0) {
    fill(0);
    textAlign(CENTER, CENTER);
    textSize(ceil(gridSize*1.4));
    text(str(marker_id), mkr_actualsize/2, -gridSize*0.5);
  }
  
  popStyle();
}

// Rebuilds markerOffsets to a centred gridN x gridN layout (CENTRE offsets in mm from the
// lid centre) ONLY when the marker count changed — so free-placed positions are preserved
// unless the grid size changes.
void ensureMarkerOffsets() {
  int gridN = max(1, markerGrid);
  int count = gridN * gridN;
  if (markerOffsets.size() == count) return;
  markerOffsets.clear();
  float mkrActualMM = Marker_Size * (9.0 / 7.0);
  float gap  = mkrActualMM * 0.2;
  float cell = mkrActualMM + gap;
  float total = gridN * mkrActualMM + (gridN - 1) * gap;
  for (int r = 0; r < gridN; r++)
    for (int c = 0; c < gridN; c++)
      markerOffsets.add(new PVector(-total / 2.0 + c * cell + mkrActualMM / 2.0,
                                    -total / 2.0 + r * cell + mkrActualMM / 2.0));
}

// Draws all markers at their stored CENTRE offsets (from the lid centre), each with a unique
// sequential ID from startId. The caller has already translated to the lid centre.
void drawMarkerGrid(float mkrSizePx, float mkrActualPx, int startId, int pos) {
  ensureMarkerOffsets();
  int id = startId;
  for (int i = 0; i < markerOffsets.size(); i++) {
    PVector off = markerOffsets.get(i);
    pushMatrix();
    translate(off.x * MM_current - mkrActualPx / 2.0, off.y * MM_current - mkrActualPx / 2.0);
    drawMarker(id, (int) mkrSizePx, pos);
    popMatrix();
    id++;
  }
}

void initMarkers(String filename) {
  // INITIALIZE ALL MARKERS
  // filename: Not used (kept for API compatibility with previous pixel-loading version)
  //           We don't load from file anymore - data is hardcoded
  
  // Called when user enables "ENABLE MARKERS" toggle (lazy initialization)
  // This function was previously: load PNG → extract pixel data → populate m[]
  // Now it's just: call initHardcodedMarkerData() which populates m[] with hardcoded values
  
  try {
    // Initialize all 1024 markers with their aruco data (hardcoded, no file I/O)
    initHardcodedMarkerData();
    
    println("Markers initialized successfully (hardcoded data)");
  } catch (Exception e) {
    println("ERROR initializing markers: " + e.getMessage());
    e.printStackTrace();
  }
}

void initHardcodedMarkerData() {
  // Initialize all 1024 marker objects
  m = new Marker[1024];
  for (int i = 0; i < m.length; i++) m[i] = new Marker();

  // Split into 4 functions to stay under 65535 byte method limit (Java/Processing constraint)
  // Each function contains ~256 markers worth of hardcoded payload data
  // Why split? A single method > 65KB causes compile error: "code exceeds 65535 bytes"
  // Solution: 4 separate functions × ~36KB each = ~144KB total data
  initMarkerData_0_255();      // Markers 0-255 (standard ArUco IDs 0-255)
  initMarkerData_256_511();    // Markers 256-511
  initMarkerData_512_767();    // Markers 512-767
  initMarkerData_768_1023();   // Markers 768-1023
  
  // After this, m[] array is fully populated and ready to draw
}

